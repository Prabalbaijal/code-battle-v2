    "test:int": "vitest run --passWithNoTests int.test"
  },
  "devDependencies": {
    "@cb/eslint-config": "workspace:*",
    "@cb/testing": "workspace:*"
  },
  "dependencies": {
    "@cb/contracts": "workspace:*",
    "@cb/db": "workspace:*",
    "@cb/ids": "workspace:*",
    "@cb/logger": "workspace:*",
    "@cb/telemetry": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "drizzle-orm": "^0.45.4",
    "kafkajs": "^2.2.4",
    "zod": "^4.6.7"
  }
}
