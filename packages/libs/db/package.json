{
  "name": "@cb/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "repo": {
    "kind": "libs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests --exclude \"**/*.int.test.ts\"",
    "test:int": "vitest run --passWithNoTests int.test"
  },
  "devDependencies": {
    "@cb/eslint-config": "workspace:*",
    "@cb/testing": "workspace:*",
    "@types/pg": "^8.23.1"
  },
  "dependencies": {
    "@cb/logger": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  }
}
