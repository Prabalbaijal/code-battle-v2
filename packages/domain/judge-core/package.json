{
  "name": "@cb/judge-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "repo": {
    "kind": "domain"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests --testTimeout=20000 --exclude \"**/*.int.test.ts\""
  },
  "devDependencies": {
    "@cb/eslint-config": "workspace:*"
  }
}
