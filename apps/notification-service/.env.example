# Copy to .env for local dev (`pnpm infra:up` starts these dependencies).
DATABASE_URL=postgres://notification_svc:notification_svc@localhost:5432/notification
REDIS_URL=redis://localhost:6379
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# In-app notifications: Kafka consumer + outbox, JWT for the API, names from user-service
KAFKA_BROKERS=localhost:19092
JWKS_URL=http://localhost:4001/.well-known/jwks.json
USER_SERVICE_URL=http://localhost:4002
# Same value in every service that calls or serves /internal/* (min 32 chars).
INTERNAL_SERVICE_SECRET=dev-internal-secret-change-me-0123456789

# fake = emails land in the fake_inbox table (read: GET http://localhost:4003/internal/dev/inbox?to=...)
EMAIL_PROVIDER=fake
# Real sending (Brevo free tier: 300/day shared). Sender must be verified in Brevo.
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=
# EMAIL_FROM=
# EMAIL_FROM_NAME=Code Battle
# The worker's Prometheus endpoint (http://localhost:9403/metrics)
METRICS_PORT=9403
