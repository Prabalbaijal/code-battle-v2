# Copy to .env for local dev (`pnpm infra:up` starts these dependencies, including fake-judge0).
DATABASE_URL=postgres://judge_svc:judge_svc@localhost:5432/judge
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:19092
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
JWKS_URL=http://localhost:4001/.well-known/jwks.json
INTERNAL_SERVICE_SECRET=dev-internal-secret-change-me-0123456789
PROBLEM_SERVICE_URL=http://localhost:4004
BATTLE_SERVICE_URL=http://localhost:4006

# fake-judge0 locally; real Judge0 (RapidAPI) later:
#   JUDGE0_URL=https://judge0-ce.p.rapidapi.com  JUDGE0_AUTH=rapidapi  JUDGE0_API_KEY=...
JUDGE0_URL=http://localhost:2358
JUDGE0_AUTH=none
# poll needs no public URL; callback needs JUDGE0_CALLBACK_BASE_URL (the web app's public origin)
JUDGE0_MODE=poll
JUDGE0_DAILY_BUDGET=1000
# Kept free for running matches; must stay below the budget (e.g. budget 20 → reserve 5 on the free plan).
MATCH_RESERVE_CALLS=40
