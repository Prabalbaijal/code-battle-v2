# Copy to .env for local dev (`pnpm infra:up` starts these dependencies).
DATABASE_URL=postgres://users_svc:users_svc@localhost:5432/users
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:19092
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
JWKS_URL=http://localhost:4001/.well-known/jwks.json
# Same value in every service that calls or serves /internal/* (min 32 chars).
INTERNAL_SERVICE_SECRET=dev-internal-secret-change-me-0123456789
# Avatar uploads (optional; without them users get an initials avatar).
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# The worker's Prometheus endpoint (http://localhost:9402/metrics)
METRICS_PORT=9402
