# Copy to .env for local dev (`pnpm infra:up` starts these dependencies).
DATABASE_URL=postgres://battle_svc:battle_svc@localhost:5432/battle
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:19092
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
JWKS_URL=http://localhost:4001/.well-known/jwks.json
# Same value in every service that calls or serves /internal/* (min 32 chars).
INTERNAL_SERVICE_SECRET=dev-internal-secret-change-me-0123456789
PROBLEM_SERVICE_URL=http://localhost:4004
JUDGE_SERVICE_URL=http://localhost:4005
USER_SERVICE_URL=http://localhost:4002
REALTIME_SERVICE_URL=http://localhost:4010
