# Copy to .env for local dev (`pnpm infra:up` starts these dependencies).
DATABASE_URL=postgres://ai_svc:ai_svc@localhost:5432/ai
KAFKA_BROKERS=localhost:19092
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
JWKS_URL=http://localhost:4001/.well-known/jwks.json
# Same value in every service that calls or serves /internal/* (min 32 chars).
INTERNAL_SERVICE_SECRET=dev-internal-secret-change-me-0123456789
JUDGE_SERVICE_URL=http://localhost:4005
PROBLEM_SERVICE_URL=http://localhost:4004
RATING_SERVICE_URL=http://localhost:4007

# Groq (free tier): create a key at https://console.groq.com/keys and paste it here.
# Without a key the AI features stay off (AI_PROVIDER falls back to none); `fake` gives scripted answers.
AI_PROVIDER=groq
GROQ_API_KEY=
# AI_MODEL_FAST=openai/gpt-oss-20b
# AI_MODEL_STRONG=openai/gpt-oss-120b
# Daily caps (UTC), kept under Groq's free tier
# AI_DAILY_TOKENS_PER_MODEL=180000
# AI_DAILY_REQUESTS_PER_MODEL=900
# AI_USER_DAILY_TOKENS=30000

# Embeddings for the tutor: a small local model, downloaded once (~30 MB)
EMBEDDINGS=local

# The worker's Prometheus endpoint (http://localhost:9408/metrics)
METRICS_PORT=9408
