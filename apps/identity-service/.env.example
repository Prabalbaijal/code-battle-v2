# Copy to .env for local dev (`pnpm infra:up` starts these dependencies).
DATABASE_URL=postgres://identity_svc:identity_svc@localhost:5432/identity
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:19092
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# `pnpm gen-keys` prints this. Without it a throwaway key is used (sessions end on restart).
# JWT_KEYS='[{"kty":"OKP","crv":"Ed25519","x":"...","d":"...","kid":"..."}]'

WEB_BASE_URL=http://localhost:3000
REALTIME_URL=http://localhost:4010
# Local dev runs on plain http, where browsers drop Secure cookies.
COOKIE_SECURE=false
# Dev/E2E only: the E2E suites register many players from one IP (must be 1 in production).
AUTH_RATE_LIMIT_SCALE=50
