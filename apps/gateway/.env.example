# Copy to .env for local dev.
REDIS_URL=redis://localhost:6379
JWKS_URL=http://localhost:4001/.well-known/jwks.json
CORS_ORIGINS=http://localhost:3000
# Behind Caddy in production: its Docker network CIDR. Locally the browser talks to Next.js,
# which proxies /api to the gateway from loopback.
TRUSTED_PROXIES=loopback
SERVICE_URL_IDENTITY=http://localhost:4001
SERVICE_URL_USER=http://localhost:4002
SERVICE_URL_PROBLEM=http://localhost:4004
SERVICE_URL_JUDGE=http://localhost:4005
SERVICE_URL_BATTLE=http://localhost:4006
SERVICE_URL_RATING=http://localhost:4007
SERVICE_URL_REALTIME=http://localhost:4010
